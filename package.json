{
  "name": "blog",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "dev:all": "npm-run-all --parallel dev:frontend dev:backend",
    "dev:frontend": "next dev",
    "dev:backend": "convex dev --tail-logs",
    "build": "next build",
    "start": "next start",
    "test": "vitest run",
    "test:http": "bun run build && vitest run --config vitest.http.config.ts",
    "lint": "biome lint ./app --write",
    "format": "biome format ./app --write",
    "check": "biome check ./app --write",
    "type-check": "tsc --noEmit",
    "sync": "bun run scripts/sync-content.ts",
    "sync:prod": "SYNC_ENV=production VERBOSE=true bun run scripts/sync-content.ts",
    "deploy": "bun run sync && bun run build",
    "deploy:prod": "bunx convex deploy && bun run sync:prod",
    "doctor": "npx react-doctor@latest . --project app,components,lib,hooks"
  },
  "dependencies": {
    "@convex-dev/aggregate": "^0.2.2",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@types/mdx": "^2.0.14",
    "@vercel/analytics": "^1.6.1",
    "@vercel/speed-insights": "^1.3.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "convex": "^1.49.0",
    "dotenv": "^16.6.1",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.511.0",
    "next": "16.4.2",
    "next-mdx-remote": "^6.0.0",
    "next-themes": "^0.4.6",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.32",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-syntax-highlighter": "^15.6.6",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.4",
    "@edge-runtime/vm": "5.0.0",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "^20.19.43",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/react-syntax-highlighter": "^15.5.13",
    "convex-test": "0.0.54",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5.9.3",
    "vitest": "4.1.10"
  },
  "overrides": {
    "brace-expansion": "1.1.13",
    "js-yaml": "3.15.0",
    "mdast-util-to-hast": "13.2.1",
    "minimatch": "3.1.4",
    "prismjs": "1.30.0",
    "shell-quote": "1.8.4",
    "yaml": "2.8.3"
  },
  "patchedDependencies": {
    "next@16.4.2": "patches/next@16.4.2.patch"
  }
}
